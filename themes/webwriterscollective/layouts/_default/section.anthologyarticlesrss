{{- $pages := where site.RegularPages "Draft" false -}}
{{- $items := where $pages "Type" "article" -}}
{{- $items = $items.ByDate.Reverse -}}

<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0">
  <channel>
    <title>{{ printf "%s – Anthology Articles" site.Title | html }}</title>
    <link>{{ .Permalink }}</link>
    <description>Articles from Web Writers’ Collective Anthologies</description>
    <language>{{ site.Language.LanguageCode }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>

    {{- range $items }}
      {{- $item := . -}}
      <item>
        <title>{{ $item.Title | html }}</title>
        <link>{{ $item.Permalink }}</link>
        <guid isPermaLink="true">{{ $item.Permalink }}</guid>

        {{- with $item.Date }}
        <pubDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        {{- end }}

        <description><![CDATA[
          {{- with $item.Params.subtitle }}
            <p>{{ . | markdownify }}</p>
          {{- end }}

          {{- with $item.Params.cover }}
            {{- $coverPath := . -}}
            {{- with $item.Resources.GetMatch $coverPath }}
              <p><img src="{{ .Permalink }}" alt="{{ $item.Title | html }}"></p>
            {{- else }}
              <p><img src="{{ $coverPath | absURL }}" alt="{{ $item.Title | html }}"></p>
            {{- end }}
          {{- end }}

          {{- with $item.Date }}
            <p>{{ .Format "2 January 2006" }}</p>
          {{- end }}

          {{- with $item.Params.authors }}
            <p>By
              {{- range $index, $author := . }}
                {{- if $index }}, {{ end -}}
                {{- $author | html -}}
              {{- end }}
            </p>
          {{- end }}

          {{- with $item.Content }}
            {{ . }}
          {{- end }}

          {{- with $item.Params.syndication_link }}
            <p><a href="{{ . }}">Read the original</a></p>
          {{- end }}
        ]]></description>
      </item>
    {{- end }}
  </channel>
</rss>
